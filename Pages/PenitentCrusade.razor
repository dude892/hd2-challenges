@page "/penitent-crusade"
@using System.Text
@using System.Text.Json
@inject CatalogService Catalog
@inject BrowserStorageService Storage
@inject FileExportService FileExport
@inject PenitentRewardService RewardService

<PageTitle>Penitent Crusade</PageTitle>

@if (!_loaded)
{
    <p class="text-light">Loading Penitent Crusade...</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="text-light mb-0">Penitent Crusade</h1>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light" @onclick="(() => _showSaveManager = true)">Save Slots</button>
            <button class="btn btn-outline-primary" @onclick="ExportPenitentSummaryAsync">Download Summary</button>
            <button class="btn btn-warning" @onclick="RestartPenitentRunAsync">Restart Run</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="alert alert-info">@_statusMessage</div>
    }

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="section-card rounded p-3">
                <h4 class="text-light">Run Settings</h4>
                <div class="mb-3">
                    <label class="form-label text-light">Difficulty</label>
                    <select class="form-select bg-dark text-light border-secondary" value="@_state.Difficulty" disabled="@(!_state.CanEditPenitentSetup)" @onchange="OnPenitentDifficultyChangedAsync">
                        @foreach (var difficulty in Catalog.PenitentDifficulties)
                        {
                            <option value="@difficulty.Id">@difficulty.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Mission stars</label>
                    <select class="form-select bg-dark text-light border-secondary" value="@_selectedStars" @onchange="OnPenitentStarsChangedAsync" disabled="@(!_state.CanEditPenitentSetup || !CanRollPunishment)">
                        @foreach (var star in Enumerable.Range(1, _state.CurrentOperation.MaxStars))
                        {
                            <option value="@star">@star</option>
                        }
                    </select>
                </div>
                <div class="d-grid gap-2">
                    <button class="btn btn-success" @onclick="BeginPenitentMissionCompleteAsync" disabled="@IsPenitentComplete">Mission Complete</button>
                    <button class="btn btn-danger" @onclick="BeginPenitentMissionFailureAsync" disabled="@(!CanRollPunishment)">Mission Failed</button>
                </div>
            </div>

            <div class="section-card rounded p-3 mt-4">
                <h4 class="text-light">Warbonds</h4>
                <div class="row g-2">
                    @foreach (var warbond in Catalog.Warbonds)
                    {
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="@warbond.InternalName" checked="@_state.SelectedWarbonds.Any(item => item.InternalName == warbond.InternalName)" disabled="@(!_state.CanEditPenitentSetup || warbond.AlwaysEnabled)" @onchange="(e => TogglePenitentWarbondAsync(warbond.InternalName, e.Value as bool? == true, warbond.AlwaysEnabled))" />
                                <label class="form-check-label text-light" for="@warbond.InternalName">@warbond.DisplayName</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Mission</small><div class="fs-5">@_state.CurrentOperation.Label</div></div></div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Difficulty</small><div class="fs-5">@_state.Difficulty.DisplayName</div></div></div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Failures</small><div class="fs-5">@_state.MissionsFailed</div></div></div>
                </div>
            </div>

            <div class="section-card rounded p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-light mb-0">Starting Loadout</h4>
                    <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                </div>
                <div class="item-grid mt-3">
                    @foreach (var item in _state.StarterItems)
                    {
                        <ItemCard Item="item" Badge="Starter" />
                    }
                </div>
            </div>

            <div class="section-card rounded p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-light mb-0">Acquired Rewards</h4>
                    <span class="text-secondary">@_state.AcquiredItems.Count item(s)</span>
                </div>
                @if (_state.AcquiredItems.Count == 0)
                {
                    <p class="text-secondary mt-3 mb-0">No rewards claimed yet.</p>
                }
                else
                {
                    @foreach (var group in _state.AcquiredItems.Categories)
                    {
                        <div class="mt-4">
                            <h5 class="text-light">@group.FirstOrDefault()?.Kind</h5>
                            <div class="item-grid">
                                @foreach (GameItem item in group)
                                {
                                    <ItemCard Item="item" />
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <Modal Title="Reward Options" Open="@_showRewardModal" OnClose="ClosePenitentRewardModal">
        @if (_state.PendingRewardItems.Count == 0)
        {
            <p class="text-secondary mb-0">No rewards available.</p>
        }
        else
        {
            <div class="item-grid">
                @foreach (var group in _state.PendingRewardItems.Categories)
                {
                    @foreach (GameItem item in group)
                    {
                        <ItemCard Item="item" OnClick="@(() => ClaimPenitentRewardAsync(item.InternalName))" />
                    }
                }
            </div>
            <div class="sticky-actions d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="ClosePenitentRewardModal">Close</button>
                <button class="btn btn-warning" @onclick="SkipAndBanPenitentRewardsAsync">Skip and Ban All</button>
            </div>
        }
    </Modal>

    <Modal Title="Punishment Options" Open="@_showPunishmentModal" OnClose="ClosePenitentPunishmentModal">
        @if (_state.PendingPunishmentItems.Count == 0)
        {
            <p class="text-secondary mb-0">No punishments available.</p>
        }
        else
        {
            <div class="item-grid">
                @foreach (var item in _state.PendingPunishmentItems)
                {
                    <ItemCard Item="item" OnClick="@(() => ClaimPenitentPunishmentAsync(item.InternalName))" />
                }
            </div>
        }
    </Modal>

    <Modal Title="Penitent Crusade Save Slots" Open="@_showSaveManager" OnClose="ClosePenitentSaveManager">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <div class="text-secondary small">Current slot</div>
                <div class="fw-semibold">@CurrentPenitentSlot?.Name</div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="CreatePenitentSnapshotAsync">Create Snapshot</button>
                <label class="btn btn-outline-light btn-sm mb-0">
                    Import Slot
                    <InputFile OnChange="ImportPenitentSlotAsync" class="d-none" accept=".json" />
                </label>
            </div>
        </div>
        @if (CurrentPenitentSlot is not null)
        {
            <div class="mb-3">
                <label class="form-label text-light">Rename current slot</label>
                <input class="form-control bg-dark text-light border-secondary" value="@CurrentPenitentSlot.Name" @onchange="RenamePenitentCurrentSlotAsync" />
            </div>
        }
        <div class="d-grid gap-2">
            @foreach (var slot in _penitentLibrary.Slots.OrderByDescending(slot => slot.UpdatedAt))
            {
                <div class="card bg-dark border-secondary">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <div class="fw-semibold">@slot.Name @if (slot.Id == _penitentLibrary.CurrentSlotId) { <span class="badge bg-primary ms-1">Current</span> }</div>
                            <div class="text-secondary small">@slot.UpdatedAt.ToLocalTime()</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-light" @onclick="(() => LoadPenitentSlotAsync(slot.Id))">Load</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="(() => ExportPenitentSlotAsync(slot.Id))">Export</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeletePenitentSlotAsync(slot.Id))">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Modal>
}

@code {
    private const string PenitentStorageKey = "blazor-penitent-crusade";
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private SaveLibrary<PenitentStateDefinition> _penitentLibrary = new();
    private PenitentState _state = default!;
    private int _selectedStars = 1;
    private bool _loaded;
    private bool _showRewardModal;
    private bool _showPunishmentModal;
    private bool _showSaveManager;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await Catalog.EnsureLoadedAsync();
        _state = new PenitentState(new PenitentStateDefinition(), GetPenitentDifficulty, GetPenitentOperation, Catalog.GetItemSet, GetPenitentStarterItems, ResolveSelectedWarbonds);
        _penitentLibrary = await Storage.GetAsync<SaveLibrary<PenitentStateDefinition>>(PenitentStorageKey) ?? new SaveLibrary<PenitentStateDefinition>();

        if (_penitentLibrary.Slots.Count == 0)
        {
            var state = CreatePenitentState();
            var slot = new SaveSlot<PenitentStateDefinition> { Name = BuildPenitentSlotName(state), State = state.ToDefinition() };
            _penitentLibrary.Slots.Add(slot);
            _penitentLibrary.CurrentSlotId = slot.Id;
            await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
        }

        EnsurePenitentCurrentSlot();
        _loaded = true;
    }

    private SaveSlot<PenitentStateDefinition>? CurrentPenitentSlot => _penitentLibrary.Slots.FirstOrDefault(slot => slot.Id == _penitentLibrary.CurrentSlotId);

    private int CurrentMissionNumber => GetMissionNumber(_state.CurrentOperation.Id, _state.CurrentOperation.MissionNumber);
    private bool IsPenitentComplete => _state.CurrentOperation.Id == Catalog.Operations.Last().Id && _state.CurrentOperation.IsComplete;
    private bool CanRollPunishment => _state.AcquiredItems.AllItems.Count > 0 && !IsPenitentComplete;

    private async Task OnPenitentDifficultyChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is string difficulty)
        {
            await ReplacePenitentStateAsync(CreatePenitentState(difficulty, _state.SelectedWarbonds));
            _statusMessage = $"Started a new { GetPenitentDifficulty(difficulty).DisplayName } run.";
        }
    }

    private Task OnPenitentStarsChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var stars))
        {
            _selectedStars = Math.Clamp(stars, 1, _state.CurrentOperation.MaxStars);
        }

        return Task.CompletedTask;
    }

    private async Task TogglePenitentWarbondAsync(string internalName, bool isChecked, bool alwaysEnabled)
    {
        if (alwaysEnabled)
        {
            return;
        }

        if (isChecked)
        {
            if (!_state.SelectedWarbonds.Any(item => item.InternalName == internalName))
            {
                var warbond = Catalog.Warbonds.First(item => item.InternalName == internalName);
                _state.SelectedWarbonds.Add(warbond);
            }
        }
        else
        {
            _state.SelectedWarbonds.RemoveAll(item => item.InternalName == internalName);
        }

        await ReplacePenitentStateAsync(CreatePenitentState(_state.Difficulty.Id, _state.SelectedWarbonds));
        _statusMessage = "Warbond filters updated.";
    }

    private async Task BeginPenitentMissionCompleteAsync()
    {
        ClampPenitentStars();
        int totalMissionCount = GetTotalPenitentMissionCount();
        if (CurrentMissionNumber >= totalMissionCount)
        {
            SetMissionProgressFromCounter(totalMissionCount + 1);
            await PersistPenitentAsync();
            _statusMessage = "Challenge complete.";
            return;
        }

        if (_state.PendingRewardItems.Count == 0)
        {
            _state.PendingRewardItems = RollPenitentRewardItems();
            _selectedStars = _state.CurrentOperation.MaxStars;
            await PersistPenitentAsync();
        }

        if (_state.PendingRewardItems.Count == 0)
        {
            _statusMessage = "No rewards available.";
            return;
        }

        _showRewardModal = true;
    }

    private async Task BeginPenitentMissionFailureAsync()
    {
        if (_state.PendingPunishmentItems.Count == 0)
        {
            var punishmentPool = _state.AcquiredItems.OrderBy(_ => Random.Shared.Next()).Take(Math.Min(3, _state.AcquiredItems.Count));
            _state.PendingPunishmentItems = Catalog.GetItemSet(punishmentPool.Select(item => item.InternalName));
            await PersistPenitentAsync();
        }

        if (_state.PendingPunishmentItems.Count == 0)
        {
            _statusMessage = "No acquired rewards are available for punishment.";
            return;
        }

        _showPunishmentModal = true;
    }

    private async Task ClaimPenitentRewardAsync(string internalName)
    {
        GameItem reward = _state.PendingRewardItems.First(item => item.InternalName == internalName);
        _state.AcquiredItems.AddItem(reward);
        if (!_state.BannedItems.Contains(reward))
        {
            _state.BannedItems.AddItem(reward);
        }

        _state.PendingRewardItems.Clear();
        _selectedStars = 1;
        AdvancePenitentMission();
        _showRewardModal = false;
        await PersistPenitentAsync();
    }

    private async Task SkipAndBanPenitentRewardsAsync()
    {
        foreach (GameItem reward in _state.PendingRewardItems)
        {
            if (!_state.BannedItems.Contains(reward))
            {
                _state.BannedItems.AddItem(reward);
            }
        }

        _state.PendingRewardItems.Clear();
        AdvancePenitentMission();
        ClampPenitentStars();
        _showRewardModal = false;
        await PersistPenitentAsync();
    }

    private async Task ClaimPenitentPunishmentAsync(string internalName)
    {
        GameItem punishment = _state.PendingPunishmentItems.First(item => item.InternalName == internalName);
        _state.AcquiredItems.RemoveItem(punishment);
        _state.BannedItems.RemoveItem(punishment);
        _state.PendingPunishmentItems.Clear();
        _state.MissionsFailed++;
        _selectedStars = 1;
        var startMission = GetMissionNumberFromOperationId(_state.Difficulty.StartOperation.Id);
        SetMissionProgressFromCounter(Math.Max(startMission, ReducePenitentMissionCounter(CurrentMissionNumber)));
        _showPunishmentModal = false;
        await PersistPenitentAsync();
    }

    private async Task RestartPenitentRunAsync()
    {
        await ReplacePenitentStateAsync(CreatePenitentState(_state.Difficulty.Id, _state.SelectedWarbonds));
        _statusMessage = "Run restarted.";
    }

    private Task ClosePenitentRewardModal()
    {
        _showRewardModal = false;
        return Task.CompletedTask;
    }

    private Task ClosePenitentPunishmentModal()
    {
        _showPunishmentModal = false;
        return Task.CompletedTask;
    }

    private Task ClosePenitentSaveManager()
    {
        _showSaveManager = false;
        return Task.CompletedTask;
    }

    private async Task CreatePenitentSnapshotAsync()
    {
        SaveSlot<PenitentStateDefinition>? slot = new SaveSlot<PenitentStateDefinition>
        {
            Name = $"{BuildPenitentSlotName(_state)} Snapshot",
            State = _state.ToDefinition(),
            UpdatedAt = DateTimeOffset.UtcNow
        };
        _penitentLibrary.Slots.Add(slot);
        _penitentLibrary.CurrentSlotId = slot.Id;
        await PersistPenitentAsync();
    }

    private async Task RenamePenitentCurrentSlotAsync(ChangeEventArgs args)
    {
        if (CurrentPenitentSlot is null)
        {
            return;
        }

        CurrentPenitentSlot.Name = string.IsNullOrWhiteSpace(args.Value?.ToString()) ? CurrentPenitentSlot.Name : args.Value!.ToString()!;
        CurrentPenitentSlot.UpdatedAt = DateTimeOffset.UtcNow;
        await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
    }

    private async Task LoadPenitentSlotAsync(Guid slotId)
    {
        _penitentLibrary.CurrentSlotId = slotId;
        EnsurePenitentCurrentSlot();
        _showSaveManager = false;
        await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
    }

    private async Task DeletePenitentSlotAsync(Guid slotId)
    {
        _penitentLibrary.Slots.RemoveAll(slot => slot.Id == slotId);
        if (_penitentLibrary.Slots.Count == 0)
        {
            PenitentState? state = CreatePenitentState();
            SaveSlot<PenitentStateDefinition>? slot = new SaveSlot<PenitentStateDefinition> { Name = BuildPenitentSlotName(state), State = state.ToDefinition() };
            _penitentLibrary.Slots.Add(slot);
            _penitentLibrary.CurrentSlotId = slot.Id;
        }
        else if (_penitentLibrary.CurrentSlotId == slotId)
        {
            _penitentLibrary.CurrentSlotId = _penitentLibrary.Slots[0].Id;
        }

        EnsurePenitentCurrentSlot();
        await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
    }

    private async Task ExportPenitentSlotAsync(Guid slotId)
    {
        SaveSlot<PenitentStateDefinition>? slot = _penitentLibrary.Slots.First(entry => entry.Id == slotId);
        await FileExport.DownloadJsonAsync($"{SanitizeFileName(slot.Name)}.json", new SaveExport<PenitentStateDefinition> { Mode = "penitent-crusade", Slot = slot });
    }

    private async Task ImportPenitentSlotAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile? file = args.File;
        await using Stream? stream = file.OpenReadStream(1024 * 1024);
        using StreamReader? reader = new StreamReader(stream);
        string? json = await reader.ReadToEndAsync();
        SaveExport<PenitentStateDefinition>? import = JsonSerializer.Deserialize<SaveExport<PenitentStateDefinition>>(json, JsonOptions);
        if (import?.Slot?.State is null || import.Mode != "penitent-crusade")
        {
            _statusMessage = "Invalid Penitent Crusade save file.";
            return;
        }

        import.Slot.Id = Guid.NewGuid();
        import.Slot.UpdatedAt = DateTimeOffset.UtcNow;
        _penitentLibrary.Slots.Add(import.Slot);
        _penitentLibrary.CurrentSlotId = import.Slot.Id;
        EnsurePenitentCurrentSlot();
        await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
        _statusMessage = $"Imported slot {import.Slot.Name}.";
    }

    private async Task ExportPenitentSummaryAsync()
    {
        int difficultyModifier = _state.Difficulty.ScoreModifier;
        int score = difficultyModifier - (_state.MissionsFailed * 50);
        IOrderedEnumerable<IGrouping<string, GameItem>>? categories = _state.AcquiredItems.GroupBy(item => item.KindLabel).OrderBy(group => group.Key);
        StringBuilder? builder = new StringBuilder();
        builder.AppendLine($"{_state.Difficulty.DisplayName} Score Summary");
        builder.AppendLine("=======================================");
        builder.AppendLine();
        builder.AppendLine($"Difficulty Modifier: {difficultyModifier}");
        builder.AppendLine($"Missions Failed: {_state.MissionsFailed}");
        builder.AppendLine($"Final Score: {score}");
        builder.AppendLine();

        foreach (string kind in new[] { "Stratagem", "Primary", "Booster", "Secondary", "Throwable", "Armor Passive" })
        {
            builder.AppendLine($"{kind}s:");
            List<GameItem>? items = categories.FirstOrDefault(group => group.Key == kind)?.ToList() ?? [];
            if (items.Count == 0)
            {
                builder.AppendLine("  - None");
            }
            else
            {
                foreach (GameItem item in items)
                {
                    builder.AppendLine($"  - {item.DisplayName}");
                }
            }

            builder.AppendLine();
        }

        await FileExport.DownloadTextAsync($"{SanitizeFileName(CurrentPenitentSlot?.Name ?? "penitent-crusade-summary")}.txt", builder.ToString());
    }

    private async Task ReplacePenitentStateAsync(PenitentState state)
    {
        _state = state;
        _selectedStars = _state.CurrentOperation.MaxStars;
        if (CurrentPenitentSlot is not null)
        {
            CurrentPenitentSlot.State = _state.ToDefinition();
        }

        await PersistPenitentAsync();
    }

    private int GetTotalPenitentMissionCount() => Catalog.Operations.Sum(operation => operation.MissionCount);

    private int GetMissionNumberFromOperationId(string operationId)
    {
        int missionNumber = 1;
        foreach (var operation in Catalog.Operations)
        {
            if (operation.Id == operationId)
            {
                return missionNumber;
            }

            missionNumber += operation.MissionCount;
        }

        return 1;
    }

    private int GetOperationIndexForId(string operationId)
    {
        for (int i = 0; i < Catalog.Operations.Count; i++)
        {
            if (Catalog.Operations[i].Id == operationId)
            {
                return i;
            }
        }

        return 0;
    }

    private int GetMissionNumber(string operationId, int missionIndex)
    {
        int missionNumber = 1;

        for (int i = 0; i < Catalog.Operations.Count; i++)
        {
            if (Catalog.Operations[i].Id == operationId)
            {
                break;
            }
            missionNumber += Catalog.Operations[i].MissionCount;
        }

        return missionNumber + missionIndex;
    }

    private void SetMissionProgressFromCounter(int missionCounter)
    {
        SetMissionProgressFromCounter(missionCounter, _state);
    }

    private void SetMissionProgressFromCounter(int missionCounter, PenitentState state)
    {
        if (missionCounter <= 0)
        {
            missionCounter = 1;
        }

        int runningTotal = 1;
        for (int i = 0; i < Catalog.Operations.Count; i++)
        {
            int operationMissionCount = Catalog.Operations[i].MissionCount;
            int endOfOperation = runningTotal + operationMissionCount - 1;

            if (missionCounter <= endOfOperation)
            {
                state.CurrentOperation = new Operation(Catalog.Operations[i], missionCounter - runningTotal);
                return;
            }

            runningTotal += operationMissionCount;
        }

        state.CurrentOperation = new Operation(Catalog.Operations.Last(), Catalog.Operations.Last().MissionCount - 1);
    }

    private void AdvancePenitentMission()
    {
        int currentMissionNumber = CurrentMissionNumber;
        int totalMissionCount = GetTotalPenitentMissionCount();
        if (currentMissionNumber >= totalMissionCount)
        {
            SetMissionProgressFromCounter(totalMissionCount + 1);
            return;
        }

        SetMissionProgressFromCounter(currentMissionNumber + 1);
    }

    private async Task PersistPenitentAsync()
    {
        if (CurrentPenitentSlot is null)
        {
            return;
        }

        CurrentPenitentSlot.State = _state.ToDefinition();
        CurrentPenitentSlot.UpdatedAt = DateTimeOffset.UtcNow;
        await Storage.SetAsync(PenitentStorageKey, _penitentLibrary);
    }

    private void EnsurePenitentCurrentSlot()
    {
        SaveSlot<PenitentStateDefinition>? slot = CurrentPenitentSlot ?? _penitentLibrary.Slots.First();
        _penitentLibrary.CurrentSlotId = slot.Id;
        _state = new PenitentState(slot.State, GetPenitentDifficulty, GetPenitentOperation, Catalog.GetItemSet, GetPenitentStarterItems, ResolveSelectedWarbonds);
        _selectedStars = Math.Clamp(_selectedStars, 1, _state.CurrentOperation.MaxStars);
    }

    private PenitentState CreatePenitentState(string difficulty = "normal", IEnumerable<Warbond>? selectedWarbonds = null)
    {
        List<Warbond> warbonds = selectedWarbonds?.DistinctBy(item => item.InternalName).ToList() ?? Catalog.Warbonds.ToList();
        if (!warbonds.Any(item => item.InternalName == "helldiversMobilize"))
        {
            warbonds.Add(Catalog.Warbonds.First(item => item.InternalName == "helldiversMobilize"));
        }

        int startMission = GetMissionNumberFromOperationId(GetPenitentDifficulty(difficulty).StartOperation.Id);
        var definition = new PenitentStateDefinition
        {
            DifficultyId = difficulty,
            SelectedWarbonds = warbonds.Select(item => item.InternalName).ToList(),
        };

        var state = new PenitentState(definition, GetPenitentDifficulty, GetPenitentOperation, Catalog.GetItemSet, GetPenitentStarterItems, ResolveSelectedWarbonds);
        SetMissionProgressFromCounter(startMission, state);
        _selectedStars = state.CurrentOperation.MaxStars;
        return state;
    }

    private ItemSet GetPenitentStarterItems(string difficulty)
    {
        ItemSet starterSet = Catalog.PenitentStarterLoadout.Clone();
        PenitentDifficulty difficultyOption = GetPenitentDifficulty(difficulty);

        return starterSet.ApplyOverrides(difficultyOption.LoadoutOverrides).ApplyAdditions(difficultyOption.LoadoutAdditions);
    }

    private ItemSet RollPenitentRewardItems()
    {
        return RewardService.RollRewardItems(_state, _selectedStars, CurrentMissionNumber);
    }

    private GameItem? RollPenitentItemFromPool(List<GameItem> pool)
    {
        return RewardService.RollItemFromPool(pool, CurrentMissionNumber);
    }

    private string GetMissionText(int missionCounter)
    {
        if (missionCounter > GetTotalPenitentMissionCount())
        {
            return "Challenge Complete";
        }

        var currentOperation = Catalog.Operations[Math.Clamp(GetOperationIndexForMission(missionCounter), 0, Catalog.Operations.Count - 1)];
        return $"{currentOperation.DisplayName}: Mission {missionCounter - GetOperationMissionOffset(GetOperationIndexForMission(missionCounter))}";
    }

    private int GetOperationIndexForMission(int missionCounter)
    {
        int runningTotal = 1;
        for (int i = 0; i < Catalog.Operations.Count; i++)
        {
            int operationMissionCount = Catalog.Operations[i].MissionCount;
            int endOfOperation = runningTotal + operationMissionCount - 1;
            if (missionCounter <= endOfOperation)
            {
                return i;
            }

            runningTotal += operationMissionCount;
        }

        return Catalog.Operations.Count - 1;
    }

    private int GetOperationMissionOffset(int operationIndex)
    {
        int offset = 1;
        for (int i = 0; i < operationIndex; i++)
        {
            offset += Catalog.Operations[i].MissionCount;
        }

        return offset;
    }

    private int ReducePenitentMissionCounter(int missionCounter)
    {
        return Math.Max(1, missionCounter - 1);
    }

    private void ClampPenitentStars()
    {
        _selectedStars = Math.Clamp(_selectedStars, 1, _state.CurrentOperation.MaxStars);
    }

    private string BuildPenitentSlotName(PenitentState state)
    {
        return $"{state.Difficulty.Id.ToUpperInvariant()} | {state.CurrentOperation.Label} | {DateTimeOffset.UtcNow:yyyy-MM-dd HH:mm:ss}";
    }

    private static T Clone<T>(T value) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(value, JsonOptions), JsonOptions)!;

    private static string SanitizeFileName(string value)
    {
        foreach (var invalidChar in Path.GetInvalidFileNameChars())
        {
            value = value.Replace(invalidChar, '-');
        }

        return value;
    }

    private PenitentDifficulty GetPenitentDifficulty(string id) => Catalog.PenitentDifficulties.First(option => option.Id == id);

    private List<Warbond> ResolveSelectedWarbonds(IEnumerable<string> internalNames) =>
        Catalog.Warbonds.Where(warbond => internalNames.Contains(warbond.InternalName)).ToList();

    private Operation GetPenitentOperation(string operationIndex, int missionIndex)
    {
        var definition = Catalog.Operations.First(op => op.Id == operationIndex);
        return new Operation(definition, missionIndex + 1);
    }
}
