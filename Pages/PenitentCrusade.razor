@page "/penitent-crusade"
@inject CatalogService Catalog
@inject PenitentCatalogService PenitentCatalog
@inject PenitentSaveLibraryService SaveLibrary
@inject FileExportService FileService
@inject PenitentRewardService RewardService
@inject PenitentMissionService MissionService
@inject ToastService Toasts

<PageTitle>Penitent Crusade</PageTitle>

@if (!_loaded)
{
    <p class="text-light">Loading Penitent Crusade...</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="text-light mb-0">Penitent Crusade</h1>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light" @onclick="(() => _showSaveManager = true)">Save Slots</button>
            @if (_state.RunStarted)
            {
                <button class="btn btn-outline-light" @onclick="(() => _showRunSettings = true)">Run Settings</button>
                <button class="btn btn-outline-primary" @onclick="@(async () => await FileService.DownloadTextAsync(((SaveLibrary.Library.CurrentSlot?.Name ?? "penitent-crusade-summary") + ".txt"), _state.SummaryText))">Download Summary</button>
                <button class="btn btn-warning" @onclick="RestartPenitentRunAsync">Start New Run</button>
            }
        </div>
    </div>

    @if (!_state.RunStarted)
    {
        <div class="row g-4">
            <div class="col-xl-4">
                <div class="section-card rounded p-3">
                    <h4 class="text-light">Run Settings</h4>
                    <div class="mb-3">
                        <label class="form-label text-light">Difficulty</label>
                        <select class="form-select bg-dark text-light border-secondary" value="@_state.Difficulty.Id" @onchange="OnPenitentDifficultyChangedAsync">
                            @foreach (var difficulty in PenitentCatalog.Difficulties)
                            {
                                <option value="@difficulty.Id">@difficulty.DisplayName</option>
                            }
                        </select>
                    </div>
                    <p class="text-secondary mb-0">Configure your crusade before committing to the first mission.</p>
                </div>

                <div class="section-card rounded p-3 mt-4">
                    <h4 class="text-light">Warbonds</h4>
                    <div class="item-grid mt-3">
                        @foreach (var warbond in Catalog.GetAllWarbonds())
                        {
                            var isSelected = _state.SelectedWarbonds.Contains(warbond);
                            <WarbondCard
                                Warbond="warbond"
                                IsSelected="isSelected"
                                OnClick="@(() => _state.SetWarbondSelected(warbond, !isSelected))" />
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="section-card rounded p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="text-light mb-0">Starting Loadout Preview</h4>
                        <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                    </div>
                    <div class="item-grid mt-3">
                        @foreach (var item in _state.StarterItems)
                        {
                            <ItemCard Item="item" Badge="Starter" />
                        }
                    </div>
                    <div class="d-grid mt-4">
                        <button class="btn btn-success" @onclick="async () => await SaveLibrary.BeginRun(_state)">Begin Run</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
    <div class="row g-4">
        <div class="col-12">
            <div class="row g-3 mb-3 align-items-center">
                <div class="col-md-2">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Difficulty</small><div class="fs-5">@_state.Difficulty.DisplayName</div></div></div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Operation</small><div class="fs-5">@_state.CurrentOperation.DifficultyLabel</div></div></div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Mission</small><div class="fs-5">@_state.CurrentOperation.MissionLabel</div></div></div>
                </div>
                <div class="col-md-2">
                    <div class="card bg-dark border-secondary h-100"><div class="card-body"><small class="text-secondary">Failures</small><div class="fs-5">@_state.MissionsFailed</div></div></div>
                </div>
                <div class="col-md-4">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <button class="btn btn-success btn-lg btn-block" @onclick="BeginPenitentMissionCompleteAsync" disabled="@(!_state.CanCompleteMission)">Mission Complete</button>
                        <button class="btn btn-danger btn-lg btn-block" @onclick="BeginPenitentMissionFailureAsync" disabled="@(!_state.CanFailMission)">Mission Failed</button>
                    </div>
                </div>
            </div>

            <div class="section-card rounded p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-light mb-0">Starting Loadout</h4>
                    <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                </div>
                <div class="item-grid mt-3">
                    @foreach (var item in _state.StarterItems)
                    {
                        <ItemCard Item="item" Badge="Starter" />
                    }
                </div>
            </div>

            <div class="section-card rounded p-3 mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-light mb-0">Acquired Rewards</h4>
                    <span class="text-secondary">@_state.AcquiredItems.Count item(s)</span>
                </div>
                @if (_state.AcquiredItems.Count == 0)
                {
                    <p class="text-secondary mt-3 mb-0">No rewards claimed yet.</p>
                }
                else
                {
                    @foreach (var group in _state.AcquiredItems.CategoryGroups)
                    {
                        <div class="mt-4">
                            <h5 class="text-light">@group.Label</h5>
                            <div class="item-grid">
                                @foreach (GameItem item in group.Items)
                                {
                                    <ItemCard Item="item" />
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    }

    <Modal Title="Mission Complete" Open="@_showMissionCompleteModal" OnClose="@(() => _showMissionCompleteModal = false)">
        <MainContent>
            <div>
                <label class="form-label text-light">Mission stars</label>
                <select class="form-select bg-dark text-light border-secondary" @bind="_state.CurrentOperation.SelectedStars">
                    @foreach (var star in Enumerable.Range(1, _state.CurrentOperation.MaxStars))
                    {
                        <option value="@star">@star</option>
                    }
                </select>
            </div>
        </MainContent>
        <FooterContent>
            <button class="btn btn-success" @onclick="(() => ConfirmPenitentMissionCompleteAsync(_state.CurrentOperation.SelectedStars))">Continue to Rewards</button>
        </FooterContent>
    </Modal>

    <Modal Title="Reward Options" Open="@_showRewardModal" CssClass="item-modal" OnClose="@(() => _showRewardModal = false)">
        <MainContent>
            @if (_state.PendingRewardItems.Count == 0)
            {
                <p class="text-secondary mb-0">No rewards available.</p>
            }
            else
            {
                <div class="item-grid justify-content-center" style="@($"--item-columns: {_state.PendingRewardItems.Count}")">
                    @foreach (var group in _state.PendingRewardItems.Categories)
                    {
                        @foreach (GameItem item in group)
                        {
                            <ItemCard Item="item" OnClick="@(() => ClaimPenitentRewardAsync(item.Id))" />
                        }
                    }
                </div>
            }
        </MainContent>
        <FooterContent>
            @if (_state.PendingRewardItems.Count > 0)
            {
                <button class="btn btn-warning" @onclick="SkipAndBanPenitentRewardsAsync">Skip and Ban All</button>
            }
        </FooterContent>
    </Modal>

    <Modal Title="Punishment Options" Open="@_showPunishmentModal" CssClass="item-modal" OnClose="@(() => _showPunishmentModal = false)">
        <MainContent>
            @if (_state.PendingPunishmentItems.Count == 0)
            {
                <p class="text-secondary mb-0">No punishments available.</p>
            }
            else
            {
                <div class="item-grid justify-content-center" style="@($"--item-columns: {_state.PendingPunishmentItems.Count}")">
                    @foreach (var item in _state.PendingPunishmentItems)
                    {
                        <ItemCard Item="item" OnClick="@(() => ClaimPenitentPunishmentAsync(item.Id))" />
                    }
                </div>
            }
        </MainContent>
    </Modal>

    <Modal Title="Run Settings" Open="@_showRunSettings" OnClose="@(() => _showRunSettings = false)">
        <MainContent>
            <div class="mb-4">
                <div class="text-secondary small">Difficulty</div>
                <div class="fs-5">@_state.Difficulty.DisplayName</div>
            </div>

            <div class="mb-4">
                <div class="text-secondary small mb-2">Warbonds</div>
                <div class="item-grid">
                    @foreach (var warbond in _state.SelectedWarbonds)
                    {
                        <WarbondCard Warbond="warbond" IsSelected="true" />
                    }
                </div>
            </div>

            <div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-secondary small">Starting loadout</div>
                    <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                </div>
                <div class="item-grid mt-3">
                    @foreach (var item in _state.StarterItems)
                    {
                        <ItemCard Item="item" Badge="Starter" />
                    }
                </div>
            </div>
        </MainContent>
    </Modal>

    <Modal Title="Penitent Crusade Save Slots" Open="@_showSaveManager" OnClose="@(() => _showSaveManager = false)">
        <MainContent>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <div class="text-secondary small">Current slot</div>
                    <div class="fw-semibold">@SaveLibrary.Library.CurrentSlot?.Name</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="() => SaveLibrary.CreateSnapshotAsync(_state)" disabled="@(!_state.RunStarted)">Create Snapshot</button>
                    <label class="btn btn-outline-light btn-sm mb-0">
                        Import Slot
                        <InputFile OnChange="ImportPenitentSlotAsync" class="d-none" accept=".json" />
                    </label>
                </div>
            </div>
            @if (SaveLibrary.Library.CurrentSlot is not null)
            {
                <div class="mb-3">
                    <label class="form-label text-light">Rename current slot</label>
                    <input class="form-control bg-dark text-light border-secondary" value="@SaveLibrary.Library.CurrentSlot.Name" @onchange="RenamePenitentCurrentSlotAsync" />
                </div>
            }
            <div class="d-grid gap-2">
                @foreach (var slot in SaveLibrary.Library.Slots.OrderByDescending(slot => slot.UpdatedAt))
                {
                    <div class="card bg-dark border-secondary">
                        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="fw-semibold">
                                    @slot.Name
                                    @if (slot.State is PenitentStateDefinition { RunCompleted: true })
                                    {
                                        <span class="badge bg-success ms-1">Completed</span>
                                    }
                                    @if (slot.Id == SaveLibrary.Library.CurrentSlotId)
                                    {
                                        <span class="badge bg-primary ms-1">Current</span>
                                    }
                                </div>
                                <div class="text-secondary small">@slot.UpdatedAt.ToLocalTime()</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-light" @onclick="(() => LoadPenitentSlotAsync(slot.Id))">Load</button>
                                <button class="btn btn-sm btn-outline-primary" @onclick="(() => ExportPenitentSlotAsync(slot.Id))">Export</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeletePenitentSlotAsync(slot.Id))">Delete</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </MainContent>
    </Modal>
}

@code {
    private PenitentState _state = default!;
    private bool _loaded;
    private bool _showMissionCompleteModal;
    private bool _showRewardModal;
    private bool _showPunishmentModal;
    private bool _showRunSettings;
    private bool _showSaveManager;
    protected override async Task OnInitializedAsync()
    {
        await PenitentCatalog.EnsureLoadedAsync();
        _state = await SaveLibrary.LoadAsync();
        _loaded = true;
    }

    private async Task OnPenitentDifficultyChangedAsync(ChangeEventArgs args)
    {
        if (args.Value is string difficulty && PenitentCatalog.Difficulties.Any(item => item.Id == difficulty))
        {
            _state = PenitentCatalog.CreatePenitentSetupState(difficulty, _state.SelectedWarbonds);
            Toasts.Show($"{_state.Difficulty.DisplayName} loadout preview updated.");
        }

        await Task.CompletedTask;
    }

    private Task BeginPenitentMissionCompleteAsync()
    {
        if (_state.PendingPunishmentItems.Count > 0)
        {
            return Task.CompletedTask;
        }

        if (_state.PendingRewardItems.Count > 0)
        {
            _showRewardModal = true;
            return Task.CompletedTask;
        }

        _showMissionCompleteModal = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmPenitentMissionCompleteAsync(int stars)
    {
        _showMissionCompleteModal = false;
        if (MissionService.TryCompleteFinalMission(_state))
        {
            await SaveLibrary.PersistAsync(_state);
            
            Toasts.Show("Challenge complete.");
            return;
        }

        if (RewardService.EnsurePendingRewards(_state, stars))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingRewardItems.Count == 0)
        {
            Toasts.Show("No rewards available.");
            return;
        }

        _showRewardModal = true;
    }

    private async Task BeginPenitentMissionFailureAsync()
    {
        if (_state.PendingRewardItems.Count > 0)
        {
            return;
        }

        if (RewardService.EnsurePendingPunishments(_state))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingPunishmentItems.Count == 0)
        {
            Toasts.Show("No acquired rewards are available for punishment.");
            return;
        }

        _showPunishmentModal = true;
    }

    private async Task ClaimPenitentRewardAsync(string id)
    {
        if (RewardService.ClaimReward(_state, id))
        {
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task SkipAndBanPenitentRewardsAsync()
    {
        if (RewardService.BanPendingRewards(_state))
        {
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task ClaimPenitentPunishmentAsync(string id)
    {
        if (RewardService.ClaimPunishment(_state, id))
        {
            MissionService.ApplyMissionFailure(_state);
            _showPunishmentModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task RestartPenitentRunAsync()
    {
        _state = await SaveLibrary.RestartAsync(_state);
        Toasts.Show("Run reset. Review your settings before starting a new run.");
    }

    private async Task RenamePenitentCurrentSlotAsync(ChangeEventArgs args)
    {
        if (SaveLibrary.Library.CurrentSlot is null)
        {
            return;
        }

        await SaveLibrary.RenameCurrentSlotAsync(args.Value?.ToString());
    }

    private async Task LoadPenitentSlotAsync(Guid slotId)
    {
        _showSaveManager = false;
        _state = await SaveLibrary.SelectSlotAsync(slotId);
    }

    private async Task DeletePenitentSlotAsync(Guid slotId)
    {
        _state = await SaveLibrary.DeleteSlotAsync(slotId);
    }

    private async Task ExportPenitentSlotAsync(Guid slotId)
    {
        SaveSlot<PenitentStateDefinition> slot = SaveLibrary.Library.Slots.First(entry => entry.Id == slotId);
        await FileService.DownloadJsonAsync($"{(slot.Name)}.json", SaveLibrary.CreateExport(slotId));
    }

    private async Task ImportPenitentSlotAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile? file = args.File;
        await using Stream? stream = file.OpenReadStream(1024 * 1024);
        using StreamReader? reader = new StreamReader(stream);
        string? json = await reader.ReadToEndAsync();
        (SaveSlot<PenitentStateDefinition> Slot, PenitentState State)? imported = await SaveLibrary.ImportAsync(json);
        if (imported is null)
        {
            Toasts.Show("Invalid Penitent Crusade save file.");
            return;
        }

        _state = imported.Value.State;
        Toasts.Show($"Imported slot {imported.Value.Slot.Name}.");
    }
}
