@using Hd2Challenges.Models

<Modal Title="Mission Complete" Open="ShowMissionComplete" OnClose="OnCloseMissionComplete">
    <MainContent>
        <div>
            <label class="form-label text-light">Mission stars</label>
            <div class="mission-star-rating" role="group" aria-label="Mission stars">
                @foreach (var star in Enumerable.Range(1, State.CurrentOperation.MaxStars))
                {
                    <button type="button"
                            class="mission-star-button @(State.CurrentOperation.SelectedStars >= star ? "selected" : null)"
                            aria-label="@star star@(star == 1 ? string.Empty : "s")"
                            aria-pressed="@(State.CurrentOperation.SelectedStars >= star)"
                            @onclick="() => OnStarsSelected.InvokeAsync(State.CurrentOperation.SelectedStars == star ? 0 : star)">
                        @(State.CurrentOperation.SelectedStars >= star ? "★" : "☆")
                    </button>
                }
            </div>
        </div>
    </MainContent>
    <FooterContent>
        <button class="btn btn-success" @onclick="(() => OnContinueToRewards.InvokeAsync(State.CurrentOperation.SelectedStars))">Continue to Rewards</button>
    </FooterContent>
</Modal>

<Modal Title="Reward Options" Open="ShowRewardOptions" CssClass="item-modal" OnClose="OnCloseRewardOptions">
    <MainContent>
        @if (State.PendingRewardItems.Count == 0)
        {
            <p class="text-secondary mb-0">No rewards available.</p>
        }
        else
        {
            <div class="item-grid justify-content-center" style="@($"--item-columns: {State.PendingRewardItems.Count}")">
                @foreach (var group in State.PendingRewardItems.Categories)
                {
                    @foreach (GameItem item in Catalog.GetItemsInCatalogOrder(group))
                    {
                        <ItemCard Item="item" OnClick="@(() => OnClaimReward.InvokeAsync(item.Id))" />
                    }
                }
            </div>
        }
    </MainContent>
    <FooterContent>
        @if (State.PendingRewardItems.Count > 0)
        {
            <button class="btn btn-warning" @onclick="OnSkipAndBanRewards">Skip and Ban All</button>
        }
    </FooterContent>
</Modal>

<Modal Title="Punishment Options" Open="ShowPunishmentOptions" CssClass="item-modal" OnClose="OnClosePunishmentOptions">
    <MainContent>
        @if (State.PendingPunishmentItems.Count == 0)
        {
            <p class="text-secondary mb-0">No punishments available.</p>
        }
        else
        {
            <div class="item-grid justify-content-center" style="@($"--item-columns: {State.PendingPunishmentItems.Count}")">
                @foreach (var item in Catalog.GetItemsInCatalogOrder(State.PendingPunishmentItems))
                {
                    <ItemCard Item="item" OnClick="@(() => OnClaimPunishment.InvokeAsync(item.Id))" />
                }
            </div>
        }
    </MainContent>
</Modal>

<Modal Title="Banned Items" Open="ShowBannedItems" CssClass="item-modal" OnClose="OnCloseBannedItems">
    <MainContent>
        @if (State.BannedItems.Count == 0)
        {
            <p class="text-secondary mb-0">No banned items.</p>
        }
        else
        {
            <div class="item-grid justify-content-center" style="@($"--item-columns: {State.BannedItems.Count}")">
                @foreach (var group in State.BannedItems.Categories)
                {
                    @foreach (var item in Catalog.GetItemsInCatalogOrder(group))
                    {
                        <ItemCard Item="item" />
                    }
                }
            </div>
        }
    </MainContent>
</Modal>

<Modal Title="Run Settings" Open="ShowRunSettings" OnClose="OnCloseRunSettings">
    <MainContent>
        <div class="mb-4">
            <div class="text-secondary small">Difficulty</div>
            <div class="fs-5">@State.Difficulty.DisplayName</div>
        </div>

        <div class="mb-4">
            <div class="text-secondary small mb-2">Warbonds</div>
            <div class="item-grid">
                @foreach (var warbond in State.SelectedWarbonds)
                {
                    <WarbondCard Warbond="warbond" IsSelected="true" />
                }
            </div>
        </div>

        <div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-secondary small">Starting loadout</div>
                <span class="text-secondary">@State.StarterItems.Count item(s)</span>
            </div>
            <div class="item-grid mt-3">
                @foreach (var item in Catalog.GetItemsInCatalogOrder(State.StarterItems))
                {
                    <ItemCard Item="item" Badge="Starter" />
                }
            </div>
        </div>
    </MainContent>
</Modal>

@code {
    [Parameter, EditorRequired] public RedemptionState State { get; set; } = default!;
    [Parameter, EditorRequired] public CatalogService Catalog { get; set; } = default!;
    [Parameter] public bool ShowMissionComplete { get; set; }
    [Parameter] public bool ShowRewardOptions { get; set; }
    [Parameter] public bool ShowPunishmentOptions { get; set; }
    [Parameter] public bool ShowBannedItems { get; set; }
    [Parameter] public bool ShowRunSettings { get; set; }
    [Parameter] public EventCallback<int> OnStarsSelected { get; set; }
    [Parameter] public EventCallback<int> OnContinueToRewards { get; set; }
    [Parameter] public EventCallback<string> OnClaimReward { get; set; }
    [Parameter] public EventCallback OnSkipAndBanRewards { get; set; }
    [Parameter] public EventCallback<string> OnClaimPunishment { get; set; }
    [Parameter] public EventCallback OnCloseMissionComplete { get; set; }
    [Parameter] public EventCallback OnCloseRewardOptions { get; set; }
    [Parameter] public EventCallback OnClosePunishmentOptions { get; set; }
    [Parameter] public EventCallback OnCloseBannedItems { get; set; }
    [Parameter] public EventCallback OnCloseRunSettings { get; set; }
}
