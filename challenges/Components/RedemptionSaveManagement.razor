@using Hd2Challenges.Models
@using Microsoft.AspNetCore.Components.Forms

<Modal Title="Warpath: Redemption Save Slots" Open="Open" CssClass="save-slot-modal" OnClose="OnClose">
    <HeaderButtons>
        <button class="btn btn-primary btn-sm" @onclick="OnCreateSnapshot" disabled="@(!State.RunStarted)">Create Snapshot</button>
        <label class="btn btn-outline-light btn-sm mb-0">
            Import Save
            <InputFile OnChange="OnImport" class="d-none" accept=".json" />
        </label>
    </HeaderButtons>
    <MainContent>
        <div class="d-grid gap-2">
            @if (SaveLibrary.Library.WorkingSlot is null && SaveLibrary.Library.CurrentSlot is not null)
            {
                <SaveSlotCard Slot="SaveLibrary.Library.CurrentSlot"
                              IsCurrent="true"
                              OnRename="name => OnRename.InvokeAsync((SaveLibrary.Library.CurrentSlot.Id, name))"
                              OnExport="() => OnExport.InvokeAsync(SaveLibrary.Library.CurrentSlot.Id)"
                              OnDelete="() => OnCheckDelete.InvokeAsync(SaveLibrary.Library.CurrentSlot.Id)" />
            }

            @foreach (var slot in SaveLibrary.Library.Slots.Where(slot => slot.Id != SaveLibrary.Library.CurrentSlotId).OrderByDescending(slot => slot.UpdatedAt))
            {
                <SaveSlotCard Slot="slot"
                              OnRename="name => OnRename.InvokeAsync((slot.Id, name))"
                              OnLoad="() => OnLoad.InvokeAsync(slot.Id)"
                              OnExport="() => OnExport.InvokeAsync(slot.Id)"
                              OnDelete="() => OnCheckDelete.InvokeAsync(slot.Id)" />
            }
        </div>
    </MainContent>
</Modal>

@if (SlotToDelete is { } slotToDelete)
{
    <Modal Title="Delete Current Save?" Open="true" OnClose="OnCancelDelete" CloseOnBackdrop="false">
        <MainContent>
            <p class="mb-0">Delete the current save "@slotToDelete.Name"? This cannot be undone.</p>
        </MainContent>
        <FooterContent>
            <button class="btn btn-outline-light" @onclick="OnCancelDelete">Cancel</button>
            <button class="btn btn-danger" @onclick="() => OnDelete.InvokeAsync(slotToDelete.Id)">Delete Save</button>
        </FooterContent>
    </Modal>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public RedemptionState State { get; set; } = default!;
    [Parameter, EditorRequired] public RedemptionSaveLibraryService SaveLibrary { get; set; } = default!;
    [Parameter] public SaveSlot<RedemptionStateDefinition>? SlotToDelete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCreateSnapshot { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnImport { get; set; }
    [Parameter] public EventCallback<(Guid SlotId, string Name)> OnRename { get; set; }
    [Parameter] public EventCallback<Guid> OnLoad { get; set; }
    [Parameter] public EventCallback<Guid> OnExport { get; set; }
    [Parameter] public EventCallback<Guid> OnCheckDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback OnCancelDelete { get; set; }
}
