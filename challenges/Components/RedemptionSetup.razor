@using Hd2Challenges.Models

<div class="row g-4">
    <div class="col-xl-4 d-grid row-gap-3">
        <div class="row">
            <button class="btn btn-success" @onclick="OnBeginRun">Begin Run</button>
        </div>

        <div class="row section-card rounded p-3">
            <h4 class="text-light">Run Settings</h4>
            <div class="mb-3">
                <label class="form-label text-light">Difficulty</label>
                <select class="form-select bg-dark text-light border-secondary" value="@State.Difficulty.Id" @onchange="OnDifficultyChanged">
                    @foreach (var difficulty in RedemptionCatalog.Difficulties)
                    {
                        <option value="@difficulty.Id">@difficulty.DisplayName</option>
                    }
                </select>
            </div>
            <p class="text-secondary mb-0">Configure your campaign before committing to the first mission.</p>
        </div>

        <div class="row section-card rounded p-3">
            <h4 class="text-light">Warbonds</h4>
            <div class="item-grid mt-3">
                @foreach (var warbond in Catalog.GetAllWarbonds())
                {
                    var isSelected = State.SelectedWarbonds.Contains(warbond);
                    <WarbondCard
                        Warbond="warbond"
                        IsSelected="isSelected"
                        OnClick="@(() => OnWarbondToggle.InvokeAsync(warbond))" />
                }
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="section-card rounded p-3">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="text-light mb-0">Starting Loadout Preview</h4>
                <span class="text-secondary">@State.StarterItems.Count item(s)</span>
            </div>
            <div class="item-grid mt-3">
                @foreach (var item in Catalog.GetItemsInCatalogOrder(State.StarterItems))
                {
                    <ItemCard Item="item" Badge="Starter" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RedemptionState State { get; set; } = default!;
    [Parameter, EditorRequired] public CatalogService Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public RedemptionCatalogService RedemptionCatalog { get; set; } = default!;
    [Parameter] public EventCallback OnBeginRun { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnDifficultyChanged { get; set; }
    [Parameter] public EventCallback<Warbond> OnWarbondToggle { get; set; }
}
