@using Hd2Challenges.Models

<div class="card bg-dark @(IsCurrent ? "border-primary" : "border-secondary")" role="group" aria-label="@AccessibleName">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fw-semibold text-light">
                @Slot.Name
                @if (Slot.Status == RunStatus.Completed)
                {
                    <span class="badge bg-success ms-1">Completed</span>
                }
                else if (Slot.Status == RunStatus.Failed)
                {
                    <span class="badge bg-danger ms-1">Failed</span>
                }
            </div>
            <div class="text-secondary small">@Slot.UpdatedAt.ToLocalTime()</div>
        </div>
        <div class="d-flex gap-2">
            <SaveSlotRename SlotId="Slot.Id" Name="@Slot.Name" OnSave="OnRename" />
            @if (OnLoad.HasDelegate)
            {
                <button class="btn btn-sm btn-outline-light" aria-label="Load this save slot" @onclick="OnLoad">Load</button>
            }
            <button class="btn btn-sm btn-outline-primary" aria-label="Export this save slot" @onclick="OnExport">Export</button>
            <button class="btn btn-sm btn-outline-danger" aria-label="Delete this save slot" @onclick="OnDelete">Delete</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SaveSlot<RedemptionStateDefinition> Slot { get; set; } = default!;
    [Parameter] public bool IsCurrent { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnRename { get; set; }
    [Parameter] public EventCallback OnLoad { get; set; }
    [Parameter, EditorRequired] public EventCallback OnExport { get; set; }
    [Parameter, EditorRequired] public EventCallback OnDelete { get; set; }

    private string AccessibleName => IsCurrent ? $"Save slot: {Slot.Name}, current save" : $"Save slot: {Slot.Name}";
}
