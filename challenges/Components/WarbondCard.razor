@using Hd2Challenges.Models

@if (OnClick.HasDelegate)
{
    <button type="button" class="warbond-card warbond-card-clickable card border-secondary bg-dark text-light text-center h-100 @(IsSelected ? "warbond-card-selected" : "warbond-card-unselected")" @onclick="OnClick" aria-pressed="@IsSelected">
        @CardContent
    </button>
}
else
{
    <div class="warbond-card card border-secondary bg-dark text-light text-center h-100 @(IsSelected ? "warbond-card-selected" : "warbond-card-unselected")">
        @CardContent
    </div>
}

@code {
    [Parameter, EditorRequired] public Warbond Warbond { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string _defaultBadge => Warbond.AlwaysEnabled ? "Always Enabled" : string.Empty;
    private string _imagePath => $"images/warbond/{Warbond.Id}.webp";

    private RenderFragment CardContent =>
    @<text>
        @if (!string.IsNullOrWhiteSpace(_defaultBadge))
        {
            <div class="warbond-card-badge">@_defaultBadge</div>
        }
        <img class="card-img-top warbond-card-image" src="@_imagePath" alt="@Warbond.DisplayName" />
        <div class="warbond-card-text">@Warbond.DisplayName</div>
    </text>;
}
