@page "/warpath-redemption"
@inject CatalogService Catalog
@inject RedemptionCatalogService RedemptionCatalog
@inject RedemptionSaveLibraryService SaveLibrary
@inject FileExportService FileService
@inject RedemptionRewardService RewardService
@inject RedemptionMissionService MissionService
@inject ToastService Toasts

<PageTitle>Warpath: Redemption</PageTitle>

@if (!_loaded)
{
    <p class="text-light">Loading Warpath: Redemption...</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="text-light mb-0">
                Warpath: Redemption
                @if (_state.RunStarted && SaveLibrary.Library.CurrentSlot is { } currentSlot)
                {
                    <span class="fs-5 text-secondary">@currentSlot.Name</span>
                }
            </h1>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light" @onclick="() => _showSaveManager = true">Save Slots</button>
            @if (_state.RunStarted)
            {
                <button class="btn btn-outline-light" @onclick="() => _showRunSettings = true">Run Settings</button>
                <button class="btn btn-outline-primary" @onclick="DownloadSummaryAsync">Download Summary</button>
                <button class="btn btn-warning" @onclick="RestartRedemptionRunAsync">Start New Run</button>
            }
        </div>
    </div>

    @if (!_state.RunStarted)
    {
        <RedemptionSetup State="_state"
                         Catalog="Catalog"
                         RedemptionCatalog="RedemptionCatalog"
                         OnBeginRun="BeginRunAsync"
                         OnDifficultyChanged="OnRedemptionDifficultyChanged"
                         OnWarbondToggle="ToggleWarbondSelection" />
    }
    else
    {
        <RedemptionActiveRun State="_state"
                             Catalog="Catalog"
                             OnMissionComplete="BeginRedemptionMissionCompleteAsync"
                             OnMissionFailure="BeginRedemptionMissionFailureAsync"
                             OnShowBannedItems="() => _showBannedItemsModal = true" />
    }

    <RedemptionRewards State="_state"
                       Catalog="Catalog"
                       ShowMissionComplete="_showMissionCompleteModal"
                       ShowRewardOptions="_showRewardModal"
                       ShowPunishmentOptions="_showPunishmentModal"
                       ShowBannedItems="_showBannedItemsModal"
                       ShowRunSettings="_showRunSettings"
                       OnStarsSelected="SetSelectedStars"
                       OnContinueToRewards="ConfirmRedemptionMissionCompleteAsync"
                       OnClaimReward="ClaimRedemptionRewardAsync"
                       OnSkipAndBanRewards="SkipAndBanRedemptionRewardsAsync"
                       OnClaimPunishment="ClaimRedemptionPunishmentAsync"
                       OnCloseMissionComplete="() => _showMissionCompleteModal = false"
                       OnCloseRewardOptions="() => _showRewardModal = false"
                       OnClosePunishmentOptions="() => _showPunishmentModal = false"
                       OnCloseBannedItems="() => _showBannedItemsModal = false"
                       OnCloseRunSettings="() => _showRunSettings = false" />

    <RedemptionSaveManagement Open="_showSaveManager"
                              State="_state"
                              SaveLibrary="SaveLibrary"
                              SlotToDelete="_slotToDelete"
                              OnClose="() => _showSaveManager = false"
                              OnCreateSnapshot="() => SaveLibrary.CreateSnapshotAsync(_state)"
                              OnImport="ImportRedemptionSlotAsync"
                              OnRename="RenameSaveSlotAsync"
                              OnLoad="LoadRedemptionSlotAsync"
                              OnExport="ExportRedemptionSlotAsync"
                              OnCheckDelete="CheckDeleteRedemptionSlotAsync"
                              OnDelete="DeleteRedemptionSlotAsync"
                              OnCancelDelete="() => _slotToDelete = null" />
}

@code {
    private RedemptionState _state = default!;
    private bool _loaded;
    private bool _showMissionCompleteModal;
    private bool _showRewardModal;
    private bool _showPunishmentModal;
    private bool _showRunSettings;
    private bool _showSaveManager;
    private bool _showBannedItemsModal;
    private SaveSlot<RedemptionStateDefinition>? _slotToDelete;

    protected override async Task OnInitializedAsync()
    {
        await RedemptionCatalog.EnsureLoadedAsync();
        _state = await SaveLibrary.LoadAsync();
        _loaded = true;
    }

    private Task BeginRunAsync() => SaveLibrary.BeginRun(_state);

    private void OnRedemptionDifficultyChanged(ChangeEventArgs args)
    {
        if (args.Value is string difficulty)
        {
            RedemptionDifficulty redemptionDifficulty = RedemptionCatalog.GetDifficulty(difficulty);
            _state = RedemptionCatalog.CreateRedemptionSetupState(redemptionDifficulty, _state.SelectedWarbonds);
            Toasts.Show($"{_state.Difficulty.DisplayName} loadout preview updated.");
        }
    }

    private void ToggleWarbondSelection(Warbond warbond) =>
        _state.SetWarbondSelected(warbond, !_state.SelectedWarbonds.Contains(warbond));

    private Task BeginRedemptionMissionCompleteAsync()
    {
        if (_state.PendingPunishmentItems.Count > 0)
        {
            return Task.CompletedTask;
        }

        if (_state.PendingRewardItems.Count > 0)
        {
            _showRewardModal = true;
            return Task.CompletedTask;
        }

        _showMissionCompleteModal = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmRedemptionMissionCompleteAsync(int stars)
    {
        _showMissionCompleteModal = false;
        if (MissionService.TryCompleteFinalMission(_state))
        {
            await SaveLibrary.PersistAsync(_state);
            Toasts.Show("Challenge complete.");
            return;
        }

        if (RewardService.EnsurePendingRewards(_state, stars))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingRewardItems.Count == 0)
        {
            Toasts.Show("No rewards available.");
            return;
        }

        _showRewardModal = true;
    }

    private async Task BeginRedemptionMissionFailureAsync()
    {
        if (_state.PendingRewardItems.Count > 0)
        {
            return;
        }

        if (RewardService.EnsurePendingPunishments(_state))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingPunishmentItems.Count == 0)
        {
            Toasts.Show("No acquired rewards are available for punishment.");
            return;
        }

        _showPunishmentModal = true;
    }

    private void SetSelectedStars(int stars) => _state.CurrentOperation.SelectedStars = stars;

    private async Task ClaimRedemptionRewardAsync(string id)
    {
        if (RewardService.ClaimReward(_state, id))
        {
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task SkipAndBanRedemptionRewardsAsync()
    {
        if (RewardService.BanPendingRewards(_state))
        {
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task ClaimRedemptionPunishmentAsync(string id)
    {
        if (RewardService.ClaimPunishment(_state, id))
        {
            MissionService.ApplyMissionFailure(_state);
            _showPunishmentModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task RestartRedemptionRunAsync()
    {
        _state = await SaveLibrary.RestartAsync(_state);
        Toasts.Show("Run reset. Review your settings before starting a new run.");
    }

    private async Task RenameSaveSlotAsync((Guid SlotId, string Name) rename) =>
        await RenameRedemptionSlotAsync(rename.SlotId, rename.Name);

    private async Task RenameRedemptionSlotAsync(Guid slotId, string name)
    {
        if (await SaveLibrary.RenameSlotAsync(slotId, name))
        {
            Toasts.Show("Slot name saved.");
        }
    }

    private async Task LoadRedemptionSlotAsync(Guid slotId)
    {
        _state = await SaveLibrary.SelectSlotAsync(slotId);
        var slot = SaveLibrary.GetSlot(slotId);
        Toasts.Show($"Save {slot?.Name} loaded.");
    }

    private async Task CheckDeleteRedemptionSlotAsync(Guid slotId)
    {
        if (slotId == SaveLibrary.Library.CurrentSlotId)
        {
            _slotToDelete = SaveLibrary.Library.CurrentSlot;
            return;
        }

        await DeleteRedemptionSlotAsync(slotId);
    }

    private async Task DeleteRedemptionSlotAsync(Guid slotId)
    {
        var slotToDelete = SaveLibrary.GetSlot(slotId);
        (bool deleted, _state) = await SaveLibrary.DeleteSlotAsync(slotId, _state);
        _slotToDelete = null;

        if (deleted)
        {
            Toasts.Show(message: $"{slotToDelete?.Name} deleted.");
        }
    }

    private async Task ExportRedemptionSlotAsync(Guid slotId)
    {
        SaveSlot<RedemptionStateDefinition> slot = SaveLibrary.Library.Slots.First(entry => entry.Id == slotId);
        await FileService.DownloadJsonAsync($"{slot.Name}.json", SaveLibrary.CreateExport(slotId));
    }

    private async Task ImportRedemptionSlotAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile file = args.File;
        await using Stream stream = file.OpenReadStream(1024 * 1024);
        using StreamReader reader = new(stream);
        string json = await reader.ReadToEndAsync();
        (SaveSlot<RedemptionStateDefinition> Slot, RedemptionState State)? imported = await SaveLibrary.ImportAsync(json);
        if (imported is null)
        {
            Toasts.Show("Invalid Warpath: Redemption save file.");
            return;
        }

        _state = imported.Value.State;
        Toasts.Show($"Imported slot {imported.Value.Slot.Name}.");
    }

    private Task DownloadSummaryAsync() =>
        FileService.DownloadTextAsync(
            $"{SaveLibrary.Library.CurrentSlot?.Name ?? "warpath-redemption-summary"}.txt",
            _state.SummaryText);
}
