@page "/warpath-redemption"
@inject CatalogService Catalog
@inject RedemptionCatalogService RedemptionCatalog
@inject RedemptionSaveLibraryService SaveLibrary
@inject FileExportService FileService
@inject RedemptionRewardService RewardService
@inject RedemptionMissionService MissionService
@inject ToastService Toasts

<PageTitle>Warpath: Redemption</PageTitle>

@if (!_loaded)
{
    <p class="text-light">Loading Warpath: Redemption...</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="text-light mb-0">Warpath: Redemption</h1>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-light" @onclick="(() => _showSaveManager = true)">Save Slots</button>
            @if (_state.RunStarted)
            {
                <button class="btn btn-outline-light" @onclick="(() => _showMissionProgressModal = true)">Mission Progress</button>
                <button class="btn btn-outline-light" @onclick="(() => _showRunSettings = true)">Run Settings</button>
                <button class="btn btn-outline-primary" @onclick="@(async () => await FileService.DownloadTextAsync(((SaveLibrary.Library.CurrentSlot?.Name ?? "warpath-redemption-summary") + ".txt"), _state.SummaryText))">Download Summary</button>
                <button class="btn btn-warning" @onclick="RestartRedemptionRunAsync">Start New Run</button>
            }
        </div>
    </div>

    @if (!_state.RunStarted)
    {
        <div class="row g-4">
            <div class="col-xl-4 d-grid row-gap-3">
                <div class="row">
                    <button class="btn btn-success" @onclick="async () => await SaveLibrary.BeginRun(_state)">Begin Run</button>
                </div>

                <div class="row section-card rounded p-3">
                    <h4 class="text-light">Run Settings</h4>
                    <div class="mb-3">
                        <label class="form-label text-light">Difficulty</label>
                        <select class="form-select bg-dark text-light border-secondary" value="@_state.Difficulty.Id" @onchange="OnRedemptionDifficultyChanged">
                            @foreach (var difficulty in RedemptionCatalog.Difficulties)
                            {
                                <option value="@difficulty.Id">@difficulty.DisplayName</option>
                            }
                        </select>
                    </div>
                    <p class="text-secondary mb-0">Configure your campaign before committing to the first mission.</p>
                </div>

                <div class="row section-card rounded p-3">
                    <h4 class="text-light">Warbonds</h4>
                    <div class="item-grid mt-3">
                        @foreach (var warbond in Catalog.GetAllWarbonds())
                        {
                            var isSelected = _state.SelectedWarbonds.Contains(warbond);
                            <WarbondCard
                                Warbond="warbond"
                                IsSelected="isSelected"
                                OnClick="@(() => _state.SetWarbondSelected(warbond, !isSelected))" />
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="section-card rounded p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="text-light mb-0">Starting Loadout Preview</h4>
                        <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                    </div>
                    <div class="item-grid mt-3">
                        @foreach (var item in _state.StarterItems)
                        {
                            <ItemCard Item="item" Badge="Starter" />
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12">
                <div class="row g-3 mb-3 align-items-center">
                    <div class="col-md-2">
                        <div class="card bg-dark border-secondary h-100">
                            <div class="card-body">
                                <small class="text-secondary">Difficulty</small>
                                <div class="fs-5 text-light">@_state.Difficulty.DisplayName</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-dark border-secondary h-100">
                            <div class="card-body">
                                <small class="text-secondary">Operation</small>
                                <div class="d-flex align-items-center gap-2">
                                    <img class="difficulty-icon" src="@($"svgs/difficulty/{_state.CurrentOperation.DifficultyIndex}.svg")" alt="" />
                                    <div class="fs-5 text-light">@_state.CurrentOperation.DifficultyLabel</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-dark border-secondary h-100">
                            <div class="card-body">
                                <small class="text-secondary">Mission</small>
                                <div class="fs-5 text-light">@_state.CurrentOperation.MissionLabel</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card bg-dark border-secondary h-100">
                            <div class="card-body">
                                <small class="text-secondary">Failures</small>
                                <div class="fs-5 text-light">@_state.MissionsFailed</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <button class="btn btn-success btn-lg btn-block" @onclick="BeginRedemptionMissionCompleteAsync" disabled="@(!_state.CanCompleteMission)">Mission Complete</button>
                            <button class="btn btn-danger btn-lg btn-block" @onclick="BeginRedemptionMissionFailureAsync" disabled="@(!_state.CanFailMission)">Mission Failed</button>
                            <button class="btn btn-primary btn-lg btn-block" @onclick="(() => _showBannedItemsModal = true)" disabled="@(!_state.BannedItems.Any())">Banned Items</button>
                        </div>
                    </div>
                </div>

                <div class="accordion mt-3" data-bs-theme="dark">
                    <div class="accordion-item">
                        <h4 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#equipment-collapse"
                                    aria-expanded="false" aria-controls="equipment-collapse">
                                <span class="d-flex align-items-baseline gap-3">
                                    <span>Equipment</span>
                                    <span class="text-secondary small">@_state.AcquiredItems.Count() item(s)</span>
                                </span>
                            </button>
                        </h4>
                        <div id="equipment-collapse" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <div class="d-flex flex-column gap-5">
                                    <div class="row gx-5 gy-3 align-items-start">
                                        <div class="col-12 col-sm-auto">
                                            <h5 class="text-light">Primaries</h5>
                                            <div class="item-grid run-item-grid equipment-content-item-grid" style="--equipment-card-count: @_state.AcquiredItems.Primaries.Count()">
                                                @if (!_state.AcquiredItems.Primaries.Any())
                                                {
                                                    <div class="text-secondary small">No primary items acquired.</div>
                                                }
                                                else
                                                {
                                                    foreach (GameItem item in _state.AcquiredItems.Primaries)
                                                    {
                                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm">
                                            <h5 class="text-light">Secondaries</h5>
                                            <div class="item-grid run-item-grid equipment-content-item-grid" style="--equipment-card-count: @_state.AcquiredItems.Secondaries.Count()">
                                                @if (!_state.AcquiredItems.Secondaries.Any())
                                                {
                                                    <div class="text-secondary small">No secondary items acquired.</div>
                                                }
                                                else
                                                {
                                                    foreach (GameItem item in _state.AcquiredItems.Secondaries)
                                                    {
                                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row gx-5 gy-3 align-items-start">
                                        <div class="col-12 col-sm-auto">
                                            <h5 class="text-light">Throwables</h5>
                                            <div class="item-grid run-item-grid equipment-content-item-grid" style="--equipment-card-count: @_state.AcquiredItems.Throwables.Count()">
                                                @if (!_state.AcquiredItems.Throwables.Any())
                                                {
                                                    <div class="text-secondary small">No throwable items acquired.</div>
                                                }
                                                else
                                                {
                                                    foreach (GameItem item in _state.AcquiredItems.Throwables)
                                                    {
                                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <div class="col-12 col-sm">
                                            <h5 class="text-light">Armor Passives</h5>
                                            <div class="item-grid run-item-grid equipment-content-item-grid" style="--equipment-card-count: @_state.AcquiredItems.Passives.Count()">
                                                @if (!_state.AcquiredItems.Passives.Any())
                                                {
                                                    <div class="text-secondary small">No armor passives acquired.</div>
                                                }
                                                else
                                                {
                                                    foreach (GameItem item in _state.AcquiredItems.Passives)
                                                    {
                                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-12 col-lg-9">
                        <div class="section-card rounded p-3 h-100">
                            <h5 class="text-light">Stratagems</h5>
                            <div class="item-grid run-item-grid">
                                @if (!_state.AcquiredItems.Stratagems.Any())
                                {
                                    <div class="text-secondary small">No stratagems acquired.</div>
                                }
                                else
                                {
                                    foreach (GameItem item in _state.AcquiredItems.Stratagems)
                                    {
                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-3">
                        <div class="section-card rounded p-3 h-100">
                            <h5 class="text-light">Boosters</h5>
                            <div class="item-grid run-item-grid">
                                @if (!_state.AcquiredItems.Boosters.Any())
                                {
                                    <div class="text-secondary small">No boosters acquired.</div>
                                }
                                else
                                {
                                    foreach (GameItem item in _state.AcquiredItems.Boosters)
                                    {
                                        <ItemCard Item="item" Badge="@(_state.StarterItems.ContainsItem(item) ? "Starter" : null)" />
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <Modal Title="Mission Complete" Open="@_showMissionCompleteModal" OnClose="@(() => _showMissionCompleteModal = false)">
        <MainContent>
            <div>
                <label class="form-label text-light">Mission stars</label>
                <div class="mission-star-rating" role="group" aria-label="Mission stars">
                    @foreach (var star in Enumerable.Range(1, _state.CurrentOperation.MaxStars))
                    {
                        <button type="button"
                                class="mission-star-button @(_state.CurrentOperation.SelectedStars >= star ? "selected" : null)"
                                aria-label="@star star@(star == 1 ? string.Empty : "s")"
                                aria-pressed="@(_state.CurrentOperation.SelectedStars >= star)"
                                @onclick="() => { if(_state.CurrentOperation.SelectedStars == star) _state.CurrentOperation.SelectedStars = 0; else _state.CurrentOperation.SelectedStars = star; }">
                            @(_state.CurrentOperation.SelectedStars >= star ? "★" : "☆")
                        </button>
                    }
                </div>
            </div>
        </MainContent>
        <FooterContent>
            <button class="btn btn-success" @onclick="(() => ConfirmRedemptionMissionCompleteAsync(_state.CurrentOperation.SelectedStars))">Continue to Rewards</button>
        </FooterContent>
    </Modal>

    <Modal Title="Mission Progress" Open="@_showMissionProgressModal" OnClose="@(() => _showMissionProgressModal = false)">
        <MainContent>
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <div class="card bg-dark border-secondary h-100">
                        <div class="card-body">
                            <small class="text-secondary">Successes</small>
                            <div class="fs-5 text-light">@_state.MissionHistory.Count(entry => entry.Succeeded)</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card bg-dark border-secondary h-100">
                        <div class="card-body">
                            <small class="text-secondary">Failures</small>
                            <div class="fs-5 text-light">@_state.MissionHistory.Count(entry => !entry.Succeeded)</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="card bg-dark border-secondary h-100">
                        <div class="card-body">
                            <small class="text-secondary">Stars Earned</small>
                            <div class="fs-5 text-light">@_state.MissionHistory.Sum(entry => entry.Stars)</div>
                        </div>
                    </div>
                </div>
            </div>
            @if (_state.MissionHistory.Count == 0)
            {
                <p class="text-secondary mb-0">No missions completed or failed yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-striped align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Operation</th>
                                <th scope="col">Mission</th>
                                <th scope="col">Result</th>
                                <th scope="col">Stars</th>
                                <th scope="col">Selected Item</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _state.MissionHistory.AsEnumerable().Reverse())
                            {
                                <tr>
                                    <td>@Catalog.GetOperation(entry.OperationIndex).DifficultyLabel</td>
                                    <td>@entry.MissionNumber</td>
                                    <td>@(entry.Succeeded ? "Success" : "Failure")</td>
                                    <td>@(entry.Succeeded ? new string('★', entry.Stars) : "—")</td>
                                    <td>@(entry.SelectedItemId is { } itemId ? Catalog.GetItemSet([itemId]).FirstOrDefault()?.DisplayName ?? "—" : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </MainContent>
    </Modal>

    <Modal Title="Reward Options" Open="@_showRewardModal" CssClass="item-modal" OnClose="@(() => _showRewardModal = false)">
        <MainContent>
            @if (_state.PendingRewardItems.Count == 0)
            {
                <p class="text-secondary mb-0">No rewards available.</p>
            }
            else
            {
                <div class="item-grid justify-content-center" style="@($"--item-columns: {_state.PendingRewardItems.Count}")">
                    @foreach (var group in _state.PendingRewardItems.Categories)
                    {
                        @foreach (GameItem item in group)
                        {
                            <ItemCard Item="item" OnClick="@(() => ClaimRedemptionRewardAsync(item.Id))" />
                        }
                    }
                </div>
            }
        </MainContent>
        <FooterContent>
            @if (_state.PendingRewardItems.Count > 0)
            {
                <button class="btn btn-warning" @onclick="SkipAndBanRedemptionRewardsAsync">Skip and Ban All</button>
            }
        </FooterContent>
    </Modal>

    <Modal Title="Punishment Options" Open="@_showPunishmentModal" CssClass="item-modal" OnClose="@(() => _showPunishmentModal = false)">
        <MainContent>
            @if (_state.PendingPunishmentItems.Count == 0)
            {
                <p class="text-secondary mb-0">No punishments available.</p>
            }
            else
            {
                <div class="item-grid justify-content-center" style="@($"--item-columns: {_state.PendingPunishmentItems.Count}")">
                    @foreach (var item in _state.PendingPunishmentItems)
                    {
                        <ItemCard Item="item" OnClick="@(() => ClaimRedemptionPunishmentAsync(item.Id))" />
                    }
                </div>
            }
        </MainContent>
    </Modal>

    <Modal Title="Banned Items" Open="@_showBannedItemsModal" CssClass="item-modal" OnClose="@(() => _showBannedItemsModal = false)">
        <MainContent>
            @if (_state.BannedItems.Count == 0)
            {
                <p class="text-secondary mb-0">No banned items.</p>
            }
            else
            {
                <div class="item-grid justify-content-center" style="@($"--item-columns: {_state.BannedItems.Count}")">
                    @foreach (var group in _state.BannedItems.GroupBy(item => item.Kind))
                    {
                        @foreach (var item in group)
                        {
                            <ItemCard Item="item" />
                        }
                    }
                </div>
            }
        </MainContent>
    </Modal>

    <Modal Title="Run Settings" Open="@_showRunSettings" OnClose="@(() => _showRunSettings = false)">
        <MainContent>
            <div class="mb-4">
                <div class="text-secondary small">Difficulty</div>
                <div class="fs-5">@_state.Difficulty.DisplayName</div>
            </div>

            <div class="mb-4">
                <div class="text-secondary small mb-2">Warbonds</div>
                <div class="item-grid">
                    @foreach (var warbond in _state.SelectedWarbonds)
                    {
                        <WarbondCard Warbond="warbond" IsSelected="true" />
                    }
                </div>
            </div>

            <div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-secondary small">Starting loadout</div>
                    <span class="text-secondary">@_state.StarterItems.Count item(s)</span>
                </div>
                <div class="item-grid mt-3">
                    @foreach (var item in _state.StarterItems)
                    {
                        <ItemCard Item="item" Badge="Starter" />
                    }
                </div>
            </div>
        </MainContent>
    </Modal>

    <Modal Title="Warpath: Redemption Save Slots" Open="@_showSaveManager" CssClass="save-slot-modal" OnClose="@(() => _showSaveManager = false)">
        <HeaderButtons>
            <button class="btn btn-primary btn-sm" @onclick="() => SaveLibrary.CreateSnapshotAsync(_state)" disabled="@(!_state.RunStarted)">Create Snapshot</button>
            <label class="btn btn-outline-light btn-sm mb-0">
                Import Save
                <InputFile OnChange="ImportRedemptionSlotAsync" class="d-none" accept=".json" />
            </label>
        </HeaderButtons>
        <MainContent>
            <div class="d-grid gap-2">
                @if (SaveLibrary.Library.WorkingSlot is null && SaveLibrary.Library.CurrentSlot is not null)
                {
                    <SaveSlotCard Slot="SaveLibrary.Library.CurrentSlot"
                                  IsCurrent="true"
                                  OnRename="name => RenameRedemptionSlotAsync(SaveLibrary.Library.CurrentSlot.Id, name)"
                                  OnExport="() => ExportRedemptionSlotAsync(SaveLibrary.Library.CurrentSlot.Id)"
                                  OnDelete="() => CheckDeleteRedemptionSlotAsync(SaveLibrary.Library.CurrentSlot.Id)" />
                }

                @foreach (var slot in SaveLibrary.Library.Slots.Where(slot => slot.Id != SaveLibrary.Library.CurrentSlotId).OrderByDescending(slot => slot.UpdatedAt))
                {
                    <SaveSlotCard Slot="slot"
                                  OnRename="name => RenameRedemptionSlotAsync(slot.Id, name)"
                                  OnLoad="() => LoadRedemptionSlotAsync(slot.Id)"
                                  OnExport="() => ExportRedemptionSlotAsync(slot.Id)"
                                  OnDelete="() => CheckDeleteRedemptionSlotAsync(slot.Id)" />
                }
            </div>
        </MainContent>
    </Modal>

    @if (_slotToDelete is { } slotToDelete)
    {
        <Modal Title="Delete Current Save?" Open="true" OnClose="@(() => _slotToDelete = null)" CloseOnBackdrop="false">
            <MainContent>
                <p class="mb-0">Delete the current save "@slotToDelete.Name"? This cannot be undone.</p>
            </MainContent>
            <FooterContent>
                <button class="btn btn-outline-light" @onclick="() => _slotToDelete = null">Cancel</button>
                <button class="btn btn-danger" @onclick="() => DeleteRedemptionSlotAsync(slotToDelete.Id)">Delete Save</button>
            </FooterContent>
        </Modal>
    }
}

@code {
    private RedemptionState _state = default!;
    private bool _loaded;
    private bool _showMissionCompleteModal;
    private bool _showMissionProgressModal;
    private bool _showRewardModal;
    private bool _showPunishmentModal;
    private bool _showRunSettings;
    private bool _showSaveManager;
    private bool _showBannedItemsModal;
    private SaveSlot<RedemptionStateDefinition>? _slotToDelete;

    protected override async Task OnInitializedAsync()
    {
        await RedemptionCatalog.EnsureLoadedAsync();
        _state = await SaveLibrary.LoadAsync();
        _loaded = true;
    }

    private void OnRedemptionDifficultyChanged(ChangeEventArgs args)
    {
        if (args.Value is string difficulty)
        {
            RedemptionDifficulty redemptionDifficulty = RedemptionCatalog.GetDifficulty(difficulty);
            _state = RedemptionCatalog.CreateRedemptionSetupState(redemptionDifficulty, _state.SelectedWarbonds);
            Toasts.Show($"{_state.Difficulty.DisplayName} loadout preview updated.");
        }
    }

    private Task BeginRedemptionMissionCompleteAsync()
    {
        if (_state.PendingPunishmentItems.Count > 0)
        {
            return Task.CompletedTask;
        }

        if (_state.PendingRewardItems.Count > 0)
        {
            _showRewardModal = true;
            return Task.CompletedTask;
        }

        _showMissionCompleteModal = true;
        return Task.CompletedTask;
    }

    private async Task ConfirmRedemptionMissionCompleteAsync(int stars)
    {
        _showMissionCompleteModal = false;
        MissionService.RecordMissionSuccess(_state, stars);
        if (MissionService.TryCompleteFinalMission(_state))
        {
            await SaveLibrary.PersistAsync(_state);
            
            Toasts.Show("Challenge complete.");
            return;
        }

        if (RewardService.EnsurePendingRewards(_state, stars))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingRewardItems.Count == 0)
        {
            Toasts.Show("No rewards available.");
            return;
        }

        _showRewardModal = true;
    }

    private async Task BeginRedemptionMissionFailureAsync()
    {
        if (_state.PendingRewardItems.Count > 0)
        {
            return;
        }

        if (RewardService.EnsurePendingPunishments(_state))
        {
            await SaveLibrary.PersistAsync(_state);
        }

        if (_state.PendingPunishmentItems.Count == 0)
        {
            Toasts.Show("No acquired rewards are available for punishment.");
            return;
        }

        _showPunishmentModal = true;
    }

    private async Task ClaimRedemptionRewardAsync(string id)
    {
        if (RewardService.ClaimReward(_state, id))
        {
            MissionService.RecordMissionRewardSelection(_state, id);
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task SkipAndBanRedemptionRewardsAsync()
    {
        if (RewardService.BanPendingRewards(_state))
        {
            MissionService.AdvanceMission(_state);
            _showRewardModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task ClaimRedemptionPunishmentAsync(string id)
    {
        if (RewardService.ClaimPunishment(_state, id))
        {
            MissionService.ApplyMissionFailure(_state, id);
            _showPunishmentModal = false;
            await SaveLibrary.PersistAsync(_state);
        }
    }

    private async Task RestartRedemptionRunAsync()
    {
        _state = await SaveLibrary.RestartAsync(_state);
        Toasts.Show("Run reset. Review your settings before starting a new run.");
    }

    private async Task RenameRedemptionSlotAsync(Guid slotId, string name)
    {
        if (await SaveLibrary.RenameSlotAsync(slotId, name))
        {
            Toasts.Show("Slot name saved.");
        }
    }

    private async Task LoadRedemptionSlotAsync(Guid slotId)
    {
        _state = await SaveLibrary.SelectSlotAsync(slotId);
        var slot = SaveLibrary.GetSlot(slotId);
        Toasts.Show($"Save {slot?.Name} loaded.");
    }

    private async Task CheckDeleteRedemptionSlotAsync(Guid slotId)
    {
        if (slotId == SaveLibrary.Library.CurrentSlotId)
        {
            _slotToDelete = SaveLibrary.Library.CurrentSlot;
            
            return;
        }

        await DeleteRedemptionSlotAsync(slotId);
    }

    private async Task DeleteRedemptionSlotAsync(Guid slotId)
    {
        var slotToDelete = SaveLibrary.GetSlot(slotId);
        (bool deleted, _state) = await SaveLibrary.DeleteSlotAsync(slotId, _state);

        _slotToDelete = null;

        if (deleted)
        {
            Toasts.Show(message: $"{slotToDelete?.Name} deleted.");
        }
    }

    private async Task ExportRedemptionSlotAsync(Guid slotId)
    {
        SaveSlot<RedemptionStateDefinition> slot = SaveLibrary.Library.Slots.First(entry => entry.Id == slotId);
        await FileService.DownloadJsonAsync($"{(slot.Name)}.json", SaveLibrary.CreateExport(slotId));
    }

    private async Task ImportRedemptionSlotAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile? file = args.File;
        await using Stream? stream = file.OpenReadStream(1024 * 1024);
        using StreamReader? reader = new StreamReader(stream);
        string? json = await reader.ReadToEndAsync();
        (SaveSlot<RedemptionStateDefinition> Slot, RedemptionState State)? imported = await SaveLibrary.ImportAsync(json);
        if (imported is null)
        {
            Toasts.Show("Invalid Warpath: Redemption save file.");
            return;
        }

        _state = imported.Value.State;
        Toasts.Show($"Imported slot {imported.Value.Slot.Name}.");
    }
}
