<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AssemblyName>Hd2Challenges</AssemblyName>
    <RootNamespace>Hd2Challenges</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateSvgsFromXaml"
          BeforeTargets="BeforeBuild"
          Inputs="@(XamlFiles)"
          Outputs="@(XamlFiles->'$(MSBuildProjectDirectory)\wwwroot\svgs\%(Filename).svg')">

    <!-- Run converter only when inputs changed -->
    <Exec Command="dotnet run --project ../hd2-xaml2Svg -c Release -- $(MSBuildProjectDirectory)\imports\xaml $(MSBuildProjectDirectory)\wwwroot\svgs" />
  </Target>

  <ItemGroup>
    <XamlFiles Include="$(MSBuildProjectDirectory)\imports\xaml\**\*.xaml" />
  </ItemGroup>

  <PropertyGroup>
    <CompileRemove>$(CompileRemove);tools\**\*.cs;**\obj\**\*.cs;**\bin\**\*.cs</CompileRemove>
  </PropertyGroup>

</Project>
